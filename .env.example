# Серверный ключ для Pony Alpha (НЕ добавляй NEXT_PUBLIC префикс)
PONY_ALPHA_API_KEY="your_pony_alpha_key_here"

# Дефолт под OpenRouter: https://openrouter.ai/openrouter/pony-alpha
PONY_ALPHA_BASE_URL="https://openrouter.ai/api/v1"
PONY_ALPHA_MODEL="openrouter/pony-alpha"

